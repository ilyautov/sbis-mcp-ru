    {
      "name": "sbis_add_cabinet",
      "description": "Add or update a cabinet (a named set of API credentials), from chat.\n\n⚠️ This puts the key into the chat transcript — requires\ni_understand_key_goes_to_chat=true. The terminal-free safe alternative is\nthe installer (install.py / double-click), where the key never enters chat.\n\nArgs:\n    credentials: dict with the required fields for this service\n        ({fields}). For Ozon: {{\"client_id\": \"...\", \"api_key\": \"...\"}};\n        for WB: {{\"token\": \"...\"}}.\n    name: optional label. If omitted, the cabinet is named after the real\n        shop name fetched from the marketplace (falls back to \"main\").\n    i_understand_key_goes_to_chat: must be true to proceed.\nSaved to ~/.marketplace-mcp/cabinets.json (local, chmod 600), never echoed.\n",
      "inputSchema": {
        "type": "object",
        "properties": {
          "credentials": {
            "additionalProperties": true,
            "title": "Credentials",
            "type": "object"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "i_understand_key_goes_to_chat": {
            "default": false,
            "title": "I Understand Key Goes To Chat",
            "type": "boolean"
          }
        },
        "required": [
          "credentials"
        ],
        "title": "add_cabinetArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "add_cabinetOutput"
      },
      "annotations": {
        "title": "SBIS add cabinet",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "sbis_set_key",
      "description": "Change / rotate the API key from chat (e.g. the old one expired or\nleaked).\n\n⚠️ The key goes into the chat transcript — requires\ni_understand_key_goes_to_chat=true. The safe, terminal-free alternative\nis the installer, where the key never enters chat. Use a scoped key and\nrotate it in the seller cabinet if it was exposed.\n\nArgs:\n    credentials: dict with the required fields ({fields}).\n    cabinet: which cabinet to update. Default: the active one (so \"my key\n        expired\" just works). If there is none, the cabinet is named from\n        the marketplace's shop name, else \"main\".\n    i_understand_key_goes_to_chat: must be true to proceed.\nOn success the key is validated against the marketplace and the shop name\nis reported. Saved locally (chmod 600), never echoed back.\n",
      "inputSchema": {
        "type": "object",
        "properties": {
          "credentials": {
            "additionalProperties": true,
            "title": "Credentials",
            "type": "object"
          },
          "cabinet": {
            "default": "",
            "title": "Cabinet",
            "type": "string"
          },
          "i_understand_key_goes_to_chat": {
            "default": false,
            "title": "I Understand Key Goes To Chat",
            "type": "boolean"
          }
        },
        "required": [
          "credentials"
        ],
        "title": "set_keyArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "set_keyOutput"
      },
      "annotations": {
        "title": "SBIS set / rotate key",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
