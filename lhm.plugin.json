    {
      "name": "sbis_fetch_all",
      "description": "Auto-paginate a read endpoint and return every row in one response.\n\nHandles offset, last_id, cursor (Ozon v4/v5), page and WB lastChangeDate\nstyles. The array path is taken from the catalog automatically.\n\nArgs:\n    operation_id: a read endpoint from the catalog.\n    query / body / path_values: base parameters (cursor fields are managed).\n    items_path: override the array path (default: the endpoint's own).\n    limit: page size to request.\n    max_items: hard cap to protect context (default 10000).\nReturns JSON: {\"ok\", \"items\", \"total_fetched\", \"pages_fetched\", \"truncated\"}.\n",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "body": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Body"
          },
          "path_values": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Path Values"
          },
          "items_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Items Path"
          },
          "limit": {
            "default": 1000,
            "title": "Limit",
            "type": "integer"
          },
          "max_items": {
            "default": 10000,
            "title": "Max Items",
            "type": "integer"
          }
        },
        "required": [
          "operation_id"
        ],
        "title": "fetch_all_toolArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "title": "Result",
