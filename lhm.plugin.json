{
  "identifier": "ilyautov-sbis-mcp-ru",
  "name": "SBIS MCP (RU)",
  "version": "0.2.0",
  "description": "SBIS (Saby), the other main legally-binding EDI operator in Russia, in your AI assistant: documents, EDI stages, signatures, certificates. 45 methods live in a YAML catalog; the agent searches it in plain language and calls a method through three generic tools. Reads run immediately, writes and irreversible calls require confirmation. Install with uvx, keys stay on the user's machine.",
  "author": "Ilya Utov",
  "authorUrl": "https://github.com/ilyautov",
  "homepage": "https://github.com/ilyautov/sbis-mcp-ru",
  "icon": "https://raw.githubusercontent.com/ilyautov/sbis-mcp-ru/main/assets/logo.png",
  "tags": [
    "sbis",
    "saby",
    "edi",
    "edo",
    "e-invoicing",
    "accounting",
    "documents",
    "russia"
  ],
  "localizations": [
    {
      "locale": "ru-RU",
      "name": "СБИС MCP (RU)",
      "description": "API СБИС (Saby) в ИИ-ассистенте: документы, этапы ЭДО, подпись, сертификаты. 45 методов живут в YAML-каталоге, агент ищет метод словами и вызывает его тремя инструментами. Запись и необратимое спрашивают подтверждение."
    }
  ],
