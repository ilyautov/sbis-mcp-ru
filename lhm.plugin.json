    {
      "name": "sbis_call_method",
      "description": "Execute one catalog endpoint by operation_id.\n\nRead endpoints run immediately. WRITE endpoints require confirm_write=true.\nDESTRUCTIVE endpoints require confirm_write=true AND\ni_understand_this_modifies_data=true (nothing is sent otherwise).\n\nArgs:\n    operation_id: id from the catalog (see {svc}_search_methods).\n    path_values: values for {placeholders} in the path.\n    query: query-string parameters.\n    body: JSON request body.\n    confirm_write: required for write/destructive operations.\n    i_understand_this_modifies_data: required for destructive operations.\nReturns JSON: {\"ok\": true, \"status\", \"data\"} or the error envelope.\n",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "path_values": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Path Values"
          },
          "query": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "body": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Body"
          },
          "confirm_write": {
            "default": false,
            "title": "Confirm Write",
            "type": "boolean"
          },
          "i_understand_this_modifies_data": {
            "default": false,
            "title": "I Understand This Modifies Data",
            "type": "boolean"
          }
        },
        "required": [
          "operation_id"
        ],
        "title": "call_methodArguments"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "call_methodOutput"
      },
      "annotations": {
        "title": "SBIS call catalog method",
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "sbis_call_raw",
      "description": "Execute ANY endpoint, even ones not in the catalog (full API coverage).\n\nSafety is inferred from the HTTP verb: GET=read, POST/PUT/PATCH=write,\nDELETE=destructive. Same confirmation rules as {svc}_call_method.\n\nArgs:\n    method: HTTP verb (GET/POST/PUT/PATCH/DELETE).\n    path: full path beginning with '/', e.g. \"/api/v1/supplier/sales\".\n    host: host override; defaults to the service's default host.\n    query: query-string parameters.\n    body: JSON request body.\n    confirm_write / i_understand_this_modifies_data: confirmations.\nReturns JSON: {\"ok\": true, \"status\", \"data\"} or the error envelope.\n",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "title": "Method",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
